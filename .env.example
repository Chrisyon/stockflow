# StockFlow System Environment Variables Example

# Database Configurations
DB_URL=jdbc:mysql://localhost:3306/stockflow_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security Secret Key (Use a strong 256-bit key in production)
JWT_SECRET=9a4f2c8d7e1b5a3f6c8e0d2b4a6f8c1d3e5b7a9f2c4d6e8b0a2c4e6f8a1b3c5d
JWT_EXPIRATION_MS=86400000

# Server Configuration
SERVER_PORT=8080
VITE_API_URL=http://localhost:8080/api/v1
